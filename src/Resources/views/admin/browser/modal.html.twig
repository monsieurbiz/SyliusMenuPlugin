<div class="modal monsieurbiz-sylius-menu-browser__modal" id="modal-{{ locale }}" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                {% include '@MonsieurBizSyliusMenuPlugin/admin/browser/modal/header.html.twig' %}
            </div>

            <div class="modal-body position-relative">
                {% include '@MonsieurBizSyliusMenuPlugin/admin/browser/modal/content.html.twig' %}
                <div class="monsieurbiz-sylius-menu-browser__loader d-none position-absolute w-100 h-100 start-0 top-0 bg-white opacity-75">
                    <div class="d-flex justify-content-center align-items-center h-100">
                        <div class="spinner-border" role="status">
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                {% include '@MonsieurBizSyliusMenuPlugin/admin/browser/modal/actions.html.twig' %}
            </div>
        </div>
    </div>
</div>
