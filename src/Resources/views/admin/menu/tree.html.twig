{% macro tree(tree, level, prefixes) %}
    {% import _self as self %}
    <li>
        <div class="d-flex justify-content-between">
            {% hook 'tree' with {'_prefixes': prefixes} %}
        </div>
        {% if tree.children is not empty %}
            <ul>
                {% set level = level + 1 %}
                {% for child in tree.children %}
                    {{ self.tree(child, level, prefixes) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}

{% import _self as self %}

{% set tree = this.tree %}
{% set level = 0 %}
{% set prefixes = hookable_metadata.prefixes %}

<div {{ attributes }}>
    <div class="card mb-5">
        <div class="card-body">
            <ul>
                {% for node in tree %}
                    {{ self.tree(node, level, prefixes) }}
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
